# Local backend configuration. Replace the JWT value with a unique random secret
# of at least 32 characters. Never use this example value in production.
JWT_SECRET_KEY=replace_with_a_unique_random_secret_of_at_least_32_characters
DATABASE_URL=sqlite:///./sql_app.db
CORS_ORIGINS=https://careeriq-rho.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Optional. Required only when users request JD-tailored bullets.
OPENAI_API_KEY=replace_with_your_provider_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
